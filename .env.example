# ==============================================================================
# Konfigurasi API & Google Cloud OAuth 2.0 (SIKERA Mobile)
#
# Cara pakai:
# 1. Salin file ini menjadi `.env` di root proyek (d:\sikera\.env).
# 2. Isi GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID dari Google Cloud Console.
# 3. File `.env` sudah masuk .gitignore; JANGAN commit `.env` ke Git.
# 4. JANGAN pernah menyimpan OAuth Client Secret (GOCSPX-...) di aplikasi mobile.
#    Alur OAuth 2.0 PKCE menggunakan Public Client (Android/iOS) tanpa Client Secret.
# ==============================================================================

# Base URL REST API SIKERA
API_BASE_URL=https://sikera.my.id/api/v1

# Google Cloud OAuth 2.0 Client ID (tipe "Android" & "iOS" di Google Cloud Console)
# Android package name: com.sikera.app.sikera
# Pastikan "Enable custom URI scheme" dicentang pada Advanced Settings Android Client.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Fallback opsional jika ingin memakai satu Client ID yang sama di beberapa platform
GOOGLE_CLIENT_ID=

# Redirect URI custom scheme (opsional).
# Jika dikosongkan, otomatis dibentuk dari Client ID:
#   com.googleusercontent.apps.<CLIENT_ID_PREFIX>:/oauth2redirect
# Contoh isi manual:
#   GOOGLE_ANDROID_REDIRECT_URI=com.sikera.app.sikera:/oauth2redirect
GOOGLE_ANDROID_REDIRECT_URI=
GOOGLE_IOS_REDIRECT_URI=
GOOGLE_REDIRECT_URI=
